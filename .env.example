# ─── Supabase ────────────────────────────────────────────────────────────────

# Project URL — found in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-side only, never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe ──────────────────────────────────────────────────────────────────

# Secret key — server-side only
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create products in Stripe dashboard, copy the Price IDs here
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# ─── Anthropic ───────────────────────────────────────────────────────────────

# Claude API key — server-side only, paid-tier AI features only
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ─────────────────────────────────────────────────────────────────────

# Canonical URL used for Stripe success/cancel redirects and extension API calls
# Local dev: http://localhost:3000 | Production: https://makerpeek.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
