# ─── Supabase ────────────────────────────────────────────────────────────────

# Project URL — found in Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — safe to expose to the browser (also embedded in makerpeek-landing/index.html meta for static waitlist).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — server-side only, never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# PRICING: $11/mo or $99/yr (save $33 = 25% off)

# Secret key — server-side only
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — required in production (Stripe verifies each POST signature)
STRIPE_WEBHOOK_SECRET=whsec_...

# TODO: replace with new Stripe price ID after creating in Stripe dashboard
STRIPE_PRICE_ID_MONTHLY=price_...
# TODO: replace with new Stripe price ID after creating in Stripe dashboard
STRIPE_PRICE_ID_ANNUAL=price_...

# ─── App ─────────────────────────────────────────────────────────────────────

# Canonical URL used for Stripe success/cancel redirects, OAuth callback, and extension sync
# Local dev: http://localhost:3000 | Production: https://makerpeek.com
# Static makerpeek-landing uses MAKERPEEK_CONFIG.APP_URL in config.js (no .env on static host).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth → Google OAuth: enable Google provider in Supabase dashboard.
# Redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback
# Site URL: {NEXT_PUBLIC_APP_URL}

# Optional: comma-separated extra Origins allowed to POST /api/waitlist (e.g. preview URLs).
# https://makerpeek.com and https://www.makerpeek.com are always accepted when this is set.
# WAITLIST_ALLOWED_ORIGINS=https://makerpeek-xxxx.vercel.app
